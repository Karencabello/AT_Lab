<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml = Deployment Descriptor de Tomcat.

  Aquí defines:
  - quin servlet gestiona les peticions (Jersey ServletContainer)
  - quin prefix d'URL va cap a l'API (url-pattern /api/*)
  - on ha de buscar Jersey les classes @Path (provider.packages)
-->

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">

    <servlet>
        <servlet-name>Jersey</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>

        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            <param-value>upf.at.ban</param-value>
        </init-param>

        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Jersey</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

</web-app>
